# Art Value — Supabase configuration
# Copy this file to ".env" and fill in your project's values.
# Both must be present to switch the app into Supabase (cloud + auth) mode.
# Vite bakes these into the bundle at BUILD time — rebuild after changing them.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ---- Gemini (AI Quote Diagnosis) ----
# Get a key at https://aistudio.google.com/apikey
# NOTE: this is baked into the frontend bundle — restrict the key / move to a
# serverless proxy before heavy production use. Without it, the feature runs in demo mode.
VITE_GEMINI_API_KEY=YOUR-GEMINI-API-KEY
# optional model override (default: gemini-2.0-flash)
VITE_GEMINI_MODEL=gemini-2.0-flash

# ---- Reader proxy (site text for the business analyzer) ----
# Remote CORS-friendly reader. Default: https://r.jina.ai/
# VITE_READER_PROXY=https://r.jina.ai/

# ---- Pollinations (no-key DEMO image fallback, local development only) ----
# Used ONLY when Supabase is unconfigured. It is a REMOTE service, not a local
# engine, and it never masks a configured AI Gateway failure.
# Get a free key at https://enter.pollinations.ai (sign in with GitHub → create key).
#   pk_...  publishable, frontend-safe, but rate-limited (~1 image / IP / hour)
#   sk_...  secret, no rate limit — fine for an INTERNAL/local tool, but it is baked
#           into the bundle, so never ship it on a public website.
VITE_POLLINATIONS_TOKEN=
# optional image model (default: flux). others: turbo, gptimage
VITE_POLLINATIONS_MODEL=flux

# ---- Local engines: REMOVED (2026-07-27, owner decision) ----
# ArtValue is a CLOUD-ONLY product. Every workstation-engine integration —
# ComfyUI, Fooocus, AUTOMATIC1111 and the local LLM (Ollama) — was removed from
# the application together with the pages and adapters that called them, and so
# was the gate that used to disable them in hosted builds.
#
# There is nothing left to enable. VITE_ENABLE_LOCAL_ENGINES, VITE_LOCAL_LLM_URL,
# VITE_LOCAL_LLM_MODEL, VITE_CREATIVE_LLM_MODEL, VITE_JAKE_MODEL, VITE_JAKE_BRAIN,
# VITE_LOCAL_IMAGE_URL, VITE_COMFYUI_URL and every VITE_COMFYUI_* model/checkpoint
# variable are READ BY NO CODE. Setting any of them has no effect and cannot
# re-open a local path. No setup instructions are given because there is no
# local engine to set up.
